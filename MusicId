-- ARŞİVE ŞARKI EKLEME FONKSİYONU (UI Görüntüsü)
local function addSongUI(songId, name, addedByName, addedByUserId, dbId)
    local Item = Instance.new("Frame")
    Item.Size = UDim2.new(1, -5, 0, 45)
    Item.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 6)
    
    -- Profil Fotoğrafı
    local PFP = Instance.new("ImageLabel")
    PFP.Size = UDim2.new(0, 35, 0, 35)
    PFP.Position = UDim2.new(0, 5, 0, 5)
    PFP.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    PFP.Parent = Item
    Instance.new("UICorner", PFP).CornerRadius = UDim.new(1, 0)
    
    -- Fotoğrafı çekme
    task.spawn(function()
        local userId = addedByUserId or 1 -- Yoksa Roblox kurucusu (ID 1)
        local thumbType = Enum.ThumbnailType.HeadShot
        local thumbSize = Enum.ThumbnailSize.Size48x48
        local content, isReady = Players:GetUserThumbnailAsync(userId, thumbType, thumbSize)
        if isReady then PFP.Image = content end
    end)
    
    -- Bilgi Metinleri
    local InfoLabel = Instance.new("TextLabel")
    InfoLabel.Size = UDim2.new(0.5, 0, 0.5, 0)
    InfoLabel.Position = UDim2.new(0, 50, 0, 4)
    InfoLabel.BackgroundTransparency = 1
    InfoLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
    InfoLabel.TextXAlignment = Enum.TextXAlignment.Left
    InfoLabel.Font = Enum.Font.GothamBold
    InfoLabel.TextSize = 13
    InfoLabel.Text = name .. " (" .. songId .. ")"
    InfoLabel.Name = "InfoLabel" -- Arama sistemi için isimlendirme
    InfoLabel.Parent = Item
    
    local AddedByLabel = Instance.new("TextLabel")
    AddedByLabel.Size = UDim2.new(0.5, 0, 0.5, 0)
    AddedByLabel.Position = UDim2.new(0, 50, 0, 22)
    AddedByLabel.BackgroundTransparency = 1
    AddedByLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    AddedByLabel.TextXAlignment = Enum.TextXAlignment.Left
    AddedByLabel.Font = Enum.Font.Gotham
    AddedByLabel.TextSize = 11
    AddedByLabel.Text = "Added by: " .. (addedByName or "Unknown")
    AddedByLabel.Parent = Item
    
    -- Copy Butonu
    local CopyBtn = Instance.new("TextButton")
    CopyBtn.Size = UDim2.new(0, 60, 0, 25)
    CopyBtn.Position = UDim2.new(1, -65, 0, 10)
    CopyBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
    CopyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CopyBtn.Text = "Copy"
    CopyBtn.Font = Enum.Font.Gotham
    Instance.new("UICorner", CopyBtn).CornerRadius = UDim.new(0, 4)
    CopyBtn.Parent = Item
    
    CopyBtn.MouseButton1Click:Connect(function()
        setclipboard(tostring(songId))
        CopyBtn.Text = "Copied!"
        task.wait(1)
        CopyBtn.Text = "Copy"
    end)
    
    -- ADMIN SİLME BUTONU
    if LocalPlayer.Name == ADMIN_USER then
        local DeleteBtn = Instance.new("TextButton")
        DeleteBtn.Size = UDim2.new(0, 55, 0, 25)
        DeleteBtn.Position = UDim2.new(1, -125, 0, 10)
        DeleteBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        DeleteBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        DeleteBtn.Text = "Delete"
        DeleteBtn.Font = Enum.Font.Gotham
        Instance.new("UICorner", DeleteBtn).CornerRadius = UDim.new(0, 4)
        DeleteBtn.Parent = Item
        
        DeleteBtn.MouseButton1Click:Connect(function()
            -- API üzerindeki şarkının kendi ID'sini baz alarak Delete request atıyoruz
            local deleteUrl = API_URL .. "/" .. tostring(dbId or songId)
            task.spawn(function()
                pcall(function()
                    request({ Url = deleteUrl, Method = "DELETE" })
                end)
                task.wait(0.5)
                loadSongs() -- Listeyi yenile
            end)
        end)
    end
    
    Item.Parent = ScrollArea
    ScrollArea.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

-- ARAMA FONKSİYONU
SearchBar:GetPropertyChangedSignal("Text"):Connect(function()
    local query = string.lower(SearchBar.Text)
    for _, item in ipairs(ScrollArea:GetChildren()) do
        if item:IsA("Frame") then
            local info = item:FindFirstChild("InfoLabel")
            if info then
                if query == "" or string.find(string.lower(info.Text), query) then
                    item.Visible = true
                else
                    item.Visible = false
                end
            end
        end
    end
    ScrollArea.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end)

-- VERİTABANINDAN ŞARKILARI ÇEKME
function loadSongs()
    for _, v in ipairs(ScrollArea:GetChildren()) do
        if v:IsA("Frame") then v:Destroy() end
    end
    
    task.spawn(function()
        local success, response = pcall(function() return game:HttpGet(API_URL) end)
        if success and response then
            local data = HttpService:JSONDecode(response)
            for _, song in ipairs(data) do
                -- Eklentiyi kimin yaptığı API'de kayıtlıysa onu çeker, yoksa Unknown yazar.
                -- song.id api'nin db id'si, song.audioId vb de olabilir. Standart olarak id/name dönüyor varsayıyorum.
                addSongUI(song.id, song.name, song.addedBy, song.userId, song.id)
            end
        end
    end)
end

-- YENİ ŞARKI EKLEME (ADD)
AddBtn.MouseButton1Click:Connect(function()
    if IDInput.Text ~= "" then
        local songName = NameInput.Text
        if songName == "" then songName = "Unknown Song" end
        
        -- Veritabanına şarkıyı, ekleyenin ismi ve id'si ile gönderiyoruz.
        local data = HttpService:JSONEncode({
            name = songName, 
            id = IDInput.Text,
            addedBy = LocalPlayer.Name,
            userId = LocalPlayer.UserId
        })
        
        task.spawn(function()
            pcall(function()
                request({
                    Url = API_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = data
                })
            end)
            task.wait(0.5)
            loadSongs()
        end)
        IDInput.Text = ""
        NameInput.Text = ""
    end
end)

